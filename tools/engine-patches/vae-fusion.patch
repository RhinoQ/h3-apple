diff --git a/gpu-kernels/metal/gemm/h3_vae_fused.metal b/gpu-kernels/metal/gemm/h3_vae_fused.metal
new file mode 100644
index 0000000..eb7a5fd
--- /dev/null
+++ b/gpu-kernels/metal/gemm/h3_vae_fused.metal
@@ -0,0 +1,99 @@
+#include <metal_stdlib>
+#include <metal_tensor>
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace metal;
+using namespace mpp::tensor_ops;
+
+#if defined(__HAVE_TENSOR__)
+// Same matmul tiles, full-K float accumulation and BF16 projection rounding
+// as dense_gemm_mma. Bias has its OWN BF16 rounding before the next operation.
+// Removing that rounding changes the decoder; it is not an optional fast path.
+template <int BN, bool RESIDUAL>
+static inline void h3_vae_projection(
+    const device bfloat* x, const device bfloat* w, const device bfloat* bias,
+    device bfloat* y, int K, int N, int M, int has_bias,
+    const device bfloat* gate, uint3 group)
+{
+  using T = tensor<device bfloat, dextents<int32_t, 2>, tensor_inline>;
+  T tx(const_cast<device bfloat*>(x), dextents<int32_t, 2>(K, M));
+  T tw(const_cast<device bfloat*>(w), dextents<int32_t, 2>(K, N));
+  T ty(y, dextents<int32_t, 2>(N, M));
+  constexpr auto desc = matmul2d_descriptor(128, BN, int(dynamic_extent),
+                                           false, true, false);
+  matmul2d<desc, execution_simdgroups<8>> op;
+  const int m0 = int(group.y) * 128, n0 = int(group.x) * BN;
+  auto a = tx.slice(0, m0), b = tw.slice(0, n0);
+  auto c = op.template get_destination_cooperative_tensor<
+      decltype(a), decltype(b), bfloat>();
+  op.run(a, b, c);
+  for (auto it = c.begin(); it != c.end(); ++it) {
+    if (!c.is_valid_element(it)) continue;
+    const auto ij = c.get_multidimensional_index(it);
+    const int n = n0 + ij[0], m = m0 + ij[1];
+    if (n >= N || m >= M) continue;
+    bfloat v = *it;
+    if (has_bias) v = bfloat(float(v) + float(bias[n]));
+    if (RESIDUAL) v = bfloat(float(y[size_t(m)*N+n]) + float(gate[n])*float(v));
+    *it = v;
+  }
+  c.store(ty.slice(n0, m0));
+}
+
+#define H3_VAE_PROJ(NAME, BN, RESIDUAL)                                  \
+kernel void NAME(                                                       \
+    const device bfloat* x [[buffer(0)]],                               \
+    const device bfloat* w [[buffer(1)]],                               \
+    const device bfloat* bias [[buffer(2)]],                            \
+    device bfloat* y [[buffer(3)]],                                     \
+    constant int& K [[buffer(4)]], constant int& N [[buffer(5)]],         \
+    constant int& M [[buffer(6)]], constant int& has_bias [[buffer(7)]],  \
+    const device bfloat* gate [[buffer(8)]],                            \
+    uint3 group [[threadgroup_position_in_grid]]) {                     \
+  h3_vae_projection<BN, RESIDUAL>(x,w,bias,y,K,N,M,has_bias,gate,group);   \
+}
+H3_VAE_PROJ(h3_vae_bias_n128, 128, false)
+H3_VAE_PROJ(h3_vae_bias_n256, 256, false)
+H3_VAE_PROJ(h3_vae_down_residual, 256, true)
+
+// The two halves still use independent 128x128 matmuls. Keep their BF16
+// values in cooperative tensors, apply the original bias rounding and
+// gate-first SwiGLU, then store only the FF-wide activation.
+kernel void h3_vae_up_swiglu(
+    const device bfloat* x [[buffer(0)]],
+    const device bfloat* w [[buffer(1)]],
+    const device bfloat* bias [[buffer(2)]],
+    device bfloat* y [[buffer(3)]],
+    constant int& K [[buffer(4)]], constant int& FF [[buffer(5)]],
+    constant int& M [[buffer(6)]], constant int& has_bias [[buffer(7)]],
+    uint3 group [[threadgroup_position_in_grid]])
+{
+  using T = tensor<device bfloat, dextents<int32_t, 2>, tensor_inline>;
+  T tx(const_cast<device bfloat*>(x), dextents<int32_t, 2>(K, M));
+  T tw(const_cast<device bfloat*>(w), dextents<int32_t, 2>(K, 2*FF));
+  T ty(y, dextents<int32_t, 2>(FF, M));
+  constexpr auto desc = matmul2d_descriptor(128, 128, int(dynamic_extent),
+                                           false, true, false);
+  matmul2d<desc, execution_simdgroups<8>> op;
+  const int m0 = int(group.y)*128, n0 = int(group.x)*128;
+  auto a = tx.slice(0,m0), wg = tw.slice(0,n0), wu = tw.slice(0,FF+n0);
+  auto g = op.template get_destination_cooperative_tensor<decltype(a),decltype(wg),bfloat>();
+  auto u = op.template get_destination_cooperative_tensor<decltype(a),decltype(wu),bfloat>();
+  op.run(a,wg,g);
+  op.run(a,wu,u);
+  auto iu = u.begin();
+  for (auto ig = g.begin(); ig != g.end(); ++ig, ++iu) {
+    if (!g.is_valid_element(ig)) continue;
+    const auto ij = g.get_multidimensional_index(ig);
+    const int n = n0+ij[0];
+    if (n >= FF || m0+ij[1] >= M) continue;
+    bfloat gv=*ig, uv=*iu;
+    if (has_bias) {
+      gv=bfloat(float(gv)+float(bias[n]));
+      uv=bfloat(float(uv)+float(bias[FF+n]));
+    }
+    const float gate=float(gv), value=float(uv);
+    *ig=bfloat(value*(gate/(1.0f+exp(-gate))));
+  }
+  g.store(ty.slice(n0,m0));
+}
+#endif
