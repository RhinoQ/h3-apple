+bool
+MetalMiniMaxH3Transformer::premerge_lora_factors(
+    const std::string& dit_dir, MetalCompute* mc, const std::string& adapter,
+    std::unordered_map<std::string, lora::Factors>& factors, std::string* err)
+{
+  auto fail = [&](const std::string& message) {
+    if (err) *err = "H3 premerge: " + message;
+    return false;
+  };
+  if (!mc || adapter.empty() || !factors.empty()) return fail("invalid arguments");
+  MetalMiniMaxH3Transformer binder;
+  binder._mc = mc;
+  if (!config_from_json(dit_dir, binder._cfg, err)) return false;
+  const auto& cfg = binder._cfg;
+  if (cfg.lora_premerged) return fail("source already has a merged adapter");
+  LoraSlot slot;
+  if (!binder.bind_lora_({adapter, 1.f}, slot, err)) return false;
+  if (slot.modules != 4 * (cfg.n_layers + cfg.n_refiner) ||
+      !slot.final_adaln.empty()) return fail("adapter must cover all four block projections only");
+  std::unordered_map<std::string, lora::Factors> result;
+  auto collect = [&](std::vector<BlockLora>& blocks, const std::string& prefix) {
+    for (std::size_t i = 0; i < blocks.size(); ++i) {
+      auto& b = blocks[i];
+      if (!b.adaln.empty() || b.qkv.empty() || b.out.empty() ||
+          b.fc1.empty() || b.fc2.empty()) return false;
+      const auto key = prefix + std::to_string(i) + ".";
+      result.emplace(key + "attn.qkv_proj.weight", std::move(b.qkv));
+      result.emplace(key + "attn.out_proj.weight", std::move(b.out));
+      result.emplace(key + "mlp.fc1.weight", std::move(b.fc1));
+      result.emplace(key + "mlp.fc2.weight", std::move(b.fc2));
+    }
+    return true;
+  };
+  if (!collect(slot.blocks, "blocks.") ||
+      !collect(slot.refiner, "token_refiner.blocks.")) return fail("incomplete adapter");
+  factors.swap(result);
+  return true;
+}
