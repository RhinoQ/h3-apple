+    for (int j = 0; j < 8; ++j) {
+      const bfloat input = base < K ? x[size_t(row) * K + base + j * 32 + lane] : bfloat(0);
+      invalid |= (as_type<ushort>(input) & 0x7f80u) == 0x7f80u;
+      v[j] = float(input);
+    }
+    for (int stride = 1; stride <= 4; stride *= 4) {
