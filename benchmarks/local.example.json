{
  "timeout_seconds": 10800,
  "cooldown_timeout_seconds": 1800,
  "methods": [
    {
      "id": "ours",
      "label": "FastH3 / Ours",
      "source_repo": "/absolute/path/h3-apple",
      "commit": "REPLACE_WITH_PRODUCT_COMMIT",
      "cwd": "/absolute/path/h3-apple",
      "command": [
        "/absolute/path/h3-apple/.local/envs/h3/bin/python",
        "-I",
        "-m",
        "h3_apple",
        "generate",
        "--prompt-file",
        "{prompt_file}",
        "--seed",
        "{seed}",
        "--output",
        "{output}",
        "--resolution",
        "{resolution}",
        "--duration",
        "{duration}",
        "--model-dir",
        "/absolute/path/models/h3-apple"
      ],
      "asset_receipts": [
        {
          "path": "/absolute/path/models/h3-apple/bundle.json",
          "sha256": "REPLACE_WITH_RECEIPT_SHA256"
        }
      ],
      "weights": "MiniMax H3 FL2VA + official FastH3 VSA adapter, affine INT8 group64; see model bundle",
      "recipe": "ours-v1; suite geometry, 4 forwards, full VideoVAE",
      "env": {
        "MLX_ENABLE_TF32": "0",
        "FASTVIDEO_MLX_DQ_GEMM": "1"
      },
      "runtime_files": []
    },
    {
      "id": "fastvideo",
      "label": "Official FastH3 / MLX INT6 Dense",
      "source_repo": "/absolute/path/FastVideo",
      "commit": "a943220c115228ade5d57b3bab9a6a87fd600a10",
      "cwd": "/absolute/path/FastVideo",
      "command": [
        "/absolute/path/fastvideo-env/bin/python",
        "-I",
        "examples/inference/basic/mlx_fasth3.py",
        "--model-root",
        "/absolute/path/models/FastH3-Preview-v1-Dense-DataFree",
        "--mlx-checkpoint",
        "/absolute/path/models/FastH3-MLX/int6",
        "--prompt",
        "{prompt}",
        "--seed",
        "{seed}",
        "--output-path",
        "{output}",
        "--height",
        "{model_height}",
        "--width",
        "{model_width}",
        "--num-frames",
        "{model_num_frames}",
        "--steps",
        "4",
        "--vae-dtype",
        "fp32",
        "--video-decode-backend",
        "h3-vae",
        "--no-fast",
        "--no-fast-spatial",
        "--prompt-cache-dir",
        "{prompt_cache}"
      ],
      "required_files": [
        "/absolute/path/FastVideo/examples/inference/basic/mlx_fasth3.py"
      ],
      "asset_receipts": [
        {
          "path": "/absolute/path/models/official-fasth3/asset-receipt.json",
          "sha256": "REPLACE_WITH_RECEIPT_SHA256"
        }
      ],
      "weights": "Official Preview v1 Dense DataFree at f624f08c6c279ab43534c003e556fc5b295b6558, official INT6/group64 conversion; pin the exact output checksum in the receipt.",
      "recipe": "Official dense attention, four steps, full native-resolution FP32 H3 VAE; no local patches.",
      "local_patches": [],
      "env": {
        "MLX_ENABLE_TF32": "0",
        "FASTVIDEO_MLX_DQ_GEMM": "1"
      },
      "runtime_files": []
    },
    {
      "id": "vpipe",
      "label": "vpipe / VDN",
      "source_repo": "/absolute/path/vpipe",
      "commit": "0982c8a7b44df38142f58d8cc7bc6afdf3c2e47d",
      "cwd": "/absolute/path/vpipe-workspace",
      "command": [
        "/absolute/path/vpipe/build/apps/vpipe/vpipe",
        "--config",
        "/absolute/path/vpipe-workspace/session.json",
        "--launch",
        "{pipeline}"
      ],
      "pipeline_template": "/absolute/path/vpipe/docs/pipelines/minimax-h3-vdn.vpipeline",
      "pipeline_template_sha256": "REPLACE_WITH_TEMPLATE_SHA256",
      "model_key": "local/MiniMax-H3-FL2VA-8bit",
      "required_files": [
        "/absolute/path/vpipe-workspace/session.json"
      ],
      "asset_receipts": [
        {
          "path": "/absolute/path/vpipe-workspace/asset-receipt.json",
          "sha256": "REPLACE_WITH_RECEIPT_SHA256"
        }
      ],
      "weights": "REPLACE_WITH_PINNED_FL2VA_Q8_VDN_AND_TURBO_ADAPTER_IDENTITIES",
      "recipe": "Official minimax-h3-vdn.vpipeline; six configured steps, actual forwards read from evidence; same recipe for both prompts",
      "local_patches": [],
      "env": {
        "VPIPE_FFMPEG_DIR": "/absolute/path/conda-environment/lib"
      },
      "runtime_files": []
    }
  ]
}
