+#include "minitest.h"
+#include "common/session.h"
+#include "apple-silicon/metal-compute/metal-compute.h"
+#include <bit>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+
+using namespace vpipe::metal_compute;
+namespace {
+std::uint16_t bf(float value) {
+  std::uint32_t u = std::bit_cast<std::uint32_t>(value);
+  return (u + 0x7fffu + ((u >> 16) & 1u)) >> 16;
+}
+
+// Compare the entire FFN to its original multi-dispatch expression, including
+// both intermediate BF16 rounds. Guards catch stores from partial M/N tiles.
+bool check_ffn(int rows, bool has_bias) {
+  vpipe::Session session;
+  auto* gpu = session.metal_compute();
+  if (!gpu || !gpu->supports_matrix_cores()) return true;
+  constexpr int D = 128, FF = 256;
+  auto alloc = [&](std::size_t elements) {
+    auto value = gpu->make_shared_buffer(elements * 2);
+    if (value.empty()) throw std::runtime_error("test allocation");
+    auto* p = static_cast<std::uint16_t*>(value.contents());
+    for (std::size_t i = 0; i < elements; ++i)
+      p[i] = bf(float(int((i * 37 + 11) % 193) - 96) / 127.f);
+    return value;
+  };
+  auto x = alloc(rows * D), w1 = alloc(2 * FF * D), b1 = alloc(2 * FF);
+  auto w2 = alloc(D * FF), b2 = alloc(D), gate = alloc(D);
+  auto ff = alloc(rows * 2 * FF), down = alloc(rows * D);
+  std::vector<SharedBuffer> storage, activation, result;
+  for (int arm = 0; arm < 2; ++arm) {
+    for (int width : {FF, D}) {
+      auto b = alloc(rows * width + 64);
+      std::memset(b.contents(), 0x55, 64);
+      std::memset(static_cast<char*>(b.contents()) + 64 + rows * width * 2, 0x55, 64);
+      auto view = b.subview(64, rows * width * 2);
+      (width == FF ? activation : result).push_back(std::move(view));
+      storage.push_back(std::move(b));
+    }
+  }
+  auto dense = gpu->load_library("dense_gemm_mma_bf16");
+  auto elt = gpu->load_library("llm_elementwise_bf16");
+  auto fused = gpu->load_library("h3_vae_fused");
+  auto up = dense.function("dense_gemm_mma_t_n128_f16");
+  auto dn = dense.function("dense_gemm_mma_t_n128x256_f16");
+  auto add = elt.function("bias_add_rows_f16");
+  auto silu = elt.function("swiglu_split_gate_first_f16");
+  auto residual = elt.function("gated_residual_f16");
+  auto fup = fused.function("h3_vae_up_swiglu");
+  auto fdn = fused.function("h3_vae_down_residual");
+  if (!up.valid() || !dn.valid() || !add.valid() || !silu.valid() ||
+      !residual.valid() || !fup.valid() || !fdn.valid()) return false;
+  auto stream = gpu->make_command_stream();
+  {
+    auto e = stream.begin_compute();
+    auto gemm = [&](const ComputeFunction& fn, const SharedBuffer& in,
+                    const SharedBuffer& w, const SharedBuffer& b,
+                    const SharedBuffer& out, int N, int K, int tile, bool fuse) {
+      e.set_function(fn);
+      e.set_buffer(0,in); e.set_buffer(1,w); e.set_buffer(2,b); e.set_buffer(3,out);
+      e.set_constant(4,K); e.set_constant(5,N); e.set_constant(6,rows);
+      e.set_constant(7, fuse && has_bias ? 1 : 0); e.set_buffer(8,gate);
+      e.dispatch({unsigned((N+tile-1)/tile*256),unsigned((rows+127)/128),1},{256,1,1});
+    };
+    auto bias = [&](const SharedBuffer& out, const SharedBuffer& b, int N) {
+      if (!has_bias) return;
+      e.set_function(add); e.set_buffer(0,out); e.set_buffer(1,b);
+      e.set_constant(2,N); e.set_constant(3,rows*N);
+      e.dispatch({unsigned(rows*N),1,1},{256,1,1});
+    };
+    gemm(up,x,w1,b1,ff,2*FF,D,128,false); bias(ff,b1,2*FF);
+    e.set_function(silu); e.set_buffer(0,ff); e.set_buffer(1,activation[0]);
+    e.set_constant(2,rows); e.set_constant(3,FF);
+    e.dispatch({unsigned(rows*FF),1,1},{256,1,1});
+    gemm(dn,activation[0],w2,b2,down,D,FF,256,false); bias(down,b2,D);
+    e.set_function(residual); e.set_buffer(0,result[0]); e.set_buffer(1,gate);
+    e.set_buffer(2,down); e.set_constant(3,D); e.set_constant(4,rows*D);
+    e.dispatch({unsigned(rows*D),1,1},{256,1,1});
+    gemm(fup,x,w1,b1,activation[1],FF,D,128,true);
+    gemm(fdn,activation[1],w2,b2,result[1],D,FF,256,true);
+  }
+  std::string error;
+  if (!stream.commit().wait_ok(&error)) throw std::runtime_error(error);
+  for (const auto* outputs : {&activation, &result}) {
+    if (std::memcmp((*outputs)[0].contents(),(*outputs)[1].contents(),(*outputs)[0].byte_size()) != 0) return false;
+    const auto* p = static_cast<const std::uint16_t*>((*outputs)[0].contents());
+    for (std::size_t i=0; i<(*outputs)[0].byte_size()/2; ++i)
+      if ((p[i] & 0x7f80u) == 0x7f80u) return false;
+  }
+  for (const auto& b : storage) {
+    const auto* p = static_cast<const unsigned char*>(b.contents());
+    for (std::size_t i=0; i<64; ++i)
+      if (p[i] != 0x55 || p[b.byte_size()-64+i] != 0x55) return false;
+  }
+  return true;
+}
+}
+
+TEST(minimax_h3_vvae_fused, partial_tile_with_bias) { EXPECT_TRUE(check_ffn(1,true)); }
+TEST(minimax_h3_vvae_fused, complete_tile_without_bias) { EXPECT_TRUE(check_ffn(128,false)); }
+TEST(minimax_h3_vvae_fused, tail_tile_with_bias) { EXPECT_TRUE(check_ffn(129,true)); }
