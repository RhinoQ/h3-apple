+      const uint d = (lane >> 4) + 2 * (j & 1), root = lane & 15;
+      t[j] = h4(d, simd_shuffle(v[j & ~1], root), simd_shuffle(v[j & ~1], root + 16),
+                simd_shuffle(v[j | 1], root), simd_shuffle(v[j | 1], root + 16));
+    }
+    for (int j = 0; j < 8; ++j) {
+      const int p = j & 1;
+      values[g][j] = h4(j / 2, t[p], t[p+2], t[p+4], t[p+6]);
+      invalid |= (as_type<uint>(values[g][j]) & 0x7f800000u) == 0x7f800000u;
+      maximum = max(maximum, abs(values[g][j]));
+    }
+  }
+  maximum = simd_max(invalid ? INFINITY : maximum);
+  if (lane == 0) maxima[sg] = maximum;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  maximum = simd_max(lane < 8 ? maxima[lane] : 0.0f);
+  const float scale = max(maximum / 127.0f, 1.0e-30f);
+  const bool bad_scale = (as_type<uint>(scale) & 0x7f800000u) == 0x7f800000u;
+  if (sg == 0 && lane == 0) scales[row] = scale;
+  for (int g = 0; g < G; ++g) {
+    const uint base = (g * 8 + sg) * 256;
+    if (base >= K) continue;
+    for (int j = 0; j < 8; ++j)
+      q[size_t(row)*K + base + j*32 + lane] = bad_scale ? int8_t(0) :
+          int8_t(clamp(rint(values[g][j] / scale), -127.0f, 127.0f));
+  }
+}
+
+#define H256_QUANT(NAME, K) \
+kernel void NAME(const device bfloat* x [[buffer(0)]], device int8_t* q [[buffer(1)]], \
+                 device float* scales [[buffer(2)]], uint row [[threadgroup_position_in_grid]], \
+                 uint lane [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]]) { \
+  threadgroup float maxima[8]; h256_quant<K>(x, q, scales, row, lane, sg, maxima); \
+}
+H256_QUANT(h3_vae_quant_h256_k256, 256)
+H256_QUANT(h3_vae_quant_h256_k2048, 2048)
+H256_QUANT(h3_vae_quant_h256_k8192, 8192)
+
+#if defined(__HAVE_TENSOR__)
+template<int BN>
+static inline void h3_vae_i8(const device int8_t* x, const device int8_t* w,
+    const device float* sx, const device float* sw, const device bfloat* bias,
+    device bfloat* y, int K, int N, int M, int has_bias, uint3 group) {
+  using T = tensor<device int8_t, dextents<int32_t, 2>, tensor_inline>;
+  T tx(const_cast<device int8_t*>(x), dextents<int32_t, 2>(K,M));
+  T tw(const_cast<device int8_t*>(w), dextents<int32_t, 2>(K,N));
+  constexpr auto desc = matmul2d_descriptor(128, BN, int(dynamic_extent), false, true, false);
+  matmul2d<desc, execution_simdgroups<8>> op;
+  const int m0 = int(group.y)*128, n0 = int(group.x)*BN;
+  auto a = tx.slice(0,m0), b = tw.slice(0,n0);
+  auto c = op.template get_destination_cooperative_tensor<decltype(a), decltype(b), int32_t>();
+  op.run(a,b,c);
+  for (auto it = c.begin(); it != c.end(); ++it) {
+    if (!c.is_valid_element(it)) continue;
+    const auto ij = c.get_multidimensional_index(it);
+    const int n = n0 + ij[0], m = m0 + ij[1];
+    if (n >= N || m >= M) continue;
+    const float sa = sx[m], sb = sw[n];
+    const bool invalid = ((as_type<uint>(sa) & 0x7f800000u) == 0x7f800000u) ||
+                         ((as_type<uint>(sb) & 0x7f800000u) == 0x7f800000u);
+    bfloat v = bfloat(float(*it) * sa * sb);
+    if (has_bias) v = bfloat(float(v) + float(bias[n]));
+    // Preserve invalid inputs as NaNs instead of silently quantizing them away.
+    y[size_t(m)*N+n] = invalid ? as_type<bfloat>(ushort(0x7fc0)) : v;
+  }
+}
+
+#define I8_GEMM(NAME, BN) \
+kernel void NAME(const device int8_t* x [[buffer(0)]], const device int8_t* w [[buffer(1)]], \
+    const device float* sx [[buffer(2)]], const device float* sw [[buffer(3)]], \
+    const device bfloat* bias [[buffer(4)]], device bfloat* y [[buffer(5)]], \
+    constant int& K [[buffer(6)]], constant int& N [[buffer(7)]], \
+    constant int& M [[buffer(8)]], constant int& has_bias [[buffer(9)]], \
+    uint3 group [[threadgroup_position_in_grid]]) { \
+  h3_vae_i8<BN>(x,w,sx,sw,bias,y,K,N,M,has_bias,group); \
+}
+I8_GEMM(h3_vae_i8_n128, 128)
+I8_GEMM(h3_vae_i8_n256, 256)
+#endif
