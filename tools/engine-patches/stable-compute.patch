+#ifndef VPIPE_H3_COMPUTE_POLICY_H
+#define VPIPE_H3_COMPUTE_POLICY_H
+
+#include "apple-silicon/metal-compute/metal-compute.h"
+#include "interfaces/session-context-intf.h"
+#include "common/vpipe-format.h"
+#include <cstdlib>
+#include <set>
+#include <stdexcept>
+#include <string>
+
+namespace vpipe::genai {
+
+// An internal product policy, scoped by the wrapper to its qualified device.
+// No change to upstream callers when the variable is absent.
+inline bool h3_fixed_compute()
+{
+  const char* value = std::getenv("VPIPE_H3_COMPUTE_POLICY");
+  if (!value) { return false; }
+  if (std::string(value) != "m5max-v1") {
+    throw std::runtime_error("Unknown H3 compute policy");
+  }
+  return true;
+}
+
+// Unique actual dispatch shapes, including tail bands and precision gates.
+// Kept on each model, not globally: a newly loaded model reports its routes.
+struct H3ComputeRoutes {
+  std::set<std::string> seen;
+  void note(metal_compute::MetalCompute* mc, const VpipeFormat& message)
+  {
+    if (!h3_fixed_compute() || !mc || !mc->session()) { return; }
+    const auto description = message();
+    if (seen.insert(description).second) {
+      mc->session()->log_normal(fmt("[h3-plan] {}", description));
+    }
+  }
+};
+
+}  // namespace vpipe::genai
+#endif
