+// H3's head is 64 wide, with only the first 48 channels rotated. Keep
+// the original 32-lane RMS reduction and its BF16 round before RoPE.
+// Attention consumes the interleaved QKV strides, so no head transpose
+// is needed. Each SIMD group owns one (token, head, Q-or-K) region.
+kernel void h3_vae_qk_norm_rope(
+    device bfloat* qkv [[buffer(0)]],
+    const device float* cosb [[buffer(1)]],
+    const device float* sinb [[buffer(2)]],
+    constant int& S [[buffer(3)]], constant int& H [[buffer(4)]],
+    constant float& eps [[buffer(5)]],
+    uint3 group [[threadgroup_position_in_grid]],
+    uint lane [[thread_index_in_threadgroup]])
+{
+  const int row = int(group.y), part = int(group.z);
+  if (row >= S*H || part >= 2) return;
+  const int t = row/H, h = row%H;
+  device bfloat* r = qkv + size_t(t)*H*192 + h*192 + part*64;
+  float acc = 0.0f;
+  for (int i = int(lane); i < 64; i += 32) {
+    const float v = float(r[i]);
+    acc += v*v;
+  }
+  acc = simd_sum(acc);
+  const float inv = rsqrt(acc/64.0f + eps);
+  bfloat output[2];
+  for (int j = 0; j < 2; ++j) {
+    const int d = int(lane)+j*32;
+    if (d >= 48) {
+      output[j] = bfloat(float(r[d])*inv);
+    } else {
+      const int i = d < 24 ? d : d-24;
+      const float x1 = float(bfloat(float(r[i])*inv));
+      const float x2 = float(bfloat(float(r[i+24])*inv));
+      const float c = cosb[t*24+i], s = sinb[t*24+i];
+      output[j] = bfloat(d < 24 ? x1*c-x2*s : x2*c+x1*s);
+    }
+  }
+  // Both partners must have read the old values before any in-place store.
+  threadgroup_barrier(mem_flags::mem_device);
+  r[lane] = output[0]; r[lane+32] = output[1];
+}
