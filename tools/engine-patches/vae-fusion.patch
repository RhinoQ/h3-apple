+MetalMiniMaxH3VideoVae::fused_ffn_(ComputeEncoder& enc, const Block& b, int rows)
+{
+  const int D = _cfg.dim, FF = _cfg.ffn_inner;
+  // This pair preserves the shipped H3 tile choices. Quantized weights,
+  // other architectures, forced/tuned tiles, and split contractions keep
+  // the existing path; neither a shape nor a precision is silently changed.
+  if (!_fn_fused_up.valid() || !_fn_fused_down.valid() ||
+      D != 2048 || FF != 8192 || rows < _mma_min_m ||
+      rows > row_band_(2 * FF) || b.w1.quantized || b.w2.quantized ||
+      _force_tile != 0 || !_tile_tuned.empty() ||
+      _splitk.plan(D, 2 * FF, rows).splits != 0 ||
+      _splitk.plan(FF, D, rows).splits != 0) {
+    return false;
+  }
+  _compute_routes.note(_mc, fmt(
+      "vae-ffn M={} D={} FF={} route=bf16-fused-v1 split=0", rows, D, FF));
+  enc.set_function(_fn_fused_up);
+  enc.set_buffer(0, _s.nm); enc.set_buffer(1, b.w1.w);
+  enc.set_buffer(2, b.w1.b.empty() ? b.w1.w : b.w1.b);
+  enc.set_buffer(3, _s.qkv);
+  enc.set_constant(4, D); enc.set_constant(5, FF);
+  enc.set_constant(6, rows); enc.set_constant(7, b.w1.b.empty() ? 0 : 1);
+  enc.dispatch({(unsigned)(FF / 128 * 256), (unsigned)((rows + 127) / 128), 1},
+               {256, 1, 1});
+  enc.set_function(_fn_fused_down);
+  enc.set_buffer(0, _s.qkv); enc.set_buffer(1, b.w2.w);
+  enc.set_buffer(2, b.w2.b.empty() ? b.w2.w : b.w2.b);
+  enc.set_buffer(3, _s.x);
+  enc.set_constant(4, FF); enc.set_constant(5, D);
+  enc.set_constant(6, rows); enc.set_constant(7, b.w2.b.empty() ? 0 : 1);
+  enc.set_buffer(8, b.s2);
+  enc.dispatch({(unsigned)(D / 256 * 256), (unsigned)((rows + 127) / 128), 1},
+               {256, 1, 1});
+  return true;
+}
