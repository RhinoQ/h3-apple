 TEST(minimax_h3_vvae_fused, partial_tile_with_bias) { EXPECT_TRUE(check_ffn(1,true)); }
 TEST(minimax_h3_vvae_fused, complete_tile_without_bias) { EXPECT_TRUE(check_ffn(128,false)); }
 TEST(minimax_h3_vvae_fused, tail_tile_with_bias) { EXPECT_TRUE(check_ffn(129,true)); }
+
+namespace {
+bool check_qk(int rows, int heads) {
+  vpipe::Session session;
+  auto* gpu = session.metal_compute();
+  if (!gpu || !gpu->supports_matrix_cores()) return true;
+  const int count = rows*heads*192;
+  auto original = gpu->make_shared_buffer(count*2);
+  auto storage = gpu->make_shared_buffer(count*2+128);
+  std::memset(storage.contents(),0x55,storage.byte_size());
+  auto candidate = storage.subview(64,count*2);
+  auto* input = static_cast<std::uint16_t*>(original.contents());
+  for (int i=0; i<count; ++i)
+    input[i] = bf(i<64 ? 0.f : float((i*37+11)%193-96)/127.f);
+  std::memcpy(candidate.contents(),original.contents(),count*2);
+  auto gamma = gpu->make_shared_buffer(64*2);
+  for (int i=0; i<64; ++i) static_cast<std::uint16_t*>(gamma.contents())[i]=bf(1.f);
+  auto cosine = gpu->make_shared_buffer(rows*24*sizeof(float));
+  auto sine = gpu->make_shared_buffer(rows*24*sizeof(float));
+  for (int i=0; i<rows*24; ++i) {
+    static_cast<float*>(cosine.contents())[i]=std::cos(float(i)*.03f);
+    static_cast<float*>(sine.contents())[i]=std::sin(float(i)*.03f);
+  }
+  std::vector<SharedBuffer> expected;
+  for (int i=0; i<3; ++i) expected.push_back(gpu->make_shared_buffer(rows*heads*64*2));
+  auto rope = gpu->load_library("rope_bf16");
+  auto fused = gpu->load_library("h3_vae_fused");
+  auto rms = rope.function("rms_norm_heads_strided_f16");
+  auto transpose = rope.function("transpose_rope_half_part_ftab_f16");
+  auto fn = fused.function("h3_vae_qk_norm_rope");
+  if (!rms.valid() || !transpose.valid() || !fn.valid()) return false;
+  auto stream = gpu->make_command_stream();
+  {
+    auto e = stream.begin_compute();
+    for (int qk=0; qk<2; ++qk) {
+      e.set_function(rms);e.set_buffer(0,original);e.set_buffer(1,gamma);
+      e.set_constant(2,rows);e.set_constant(3,heads);e.set_constant(4,64);
+      e.set_constant(5,heads*192);e.set_constant(6,qk*64);e.set_constant(7,1e-6f);
+      e.set_constant(8,192);e.dispatch({32,unsigned(rows*heads),1},{32,1,1});
+    }
+    for (int part=0; part<3; ++part) {
+      e.set_function(transpose);e.set_buffer(0,original);e.set_buffer(1,expected[part]);
+      e.set_buffer(2,cosine);e.set_buffer(3,sine);e.set_constant(4,heads);
+      e.set_constant(5,rows);e.set_constant(6,64);e.set_constant(7,part<2?48:0);
+      e.set_constant(8,heads*192);e.set_constant(9,part*64);e.set_constant(10,192);
+      e.dispatch({64,unsigned(rows),unsigned(heads)},{64,1,1});
+    }
+    e.set_function(fn);e.set_buffer(0,candidate);e.set_buffer(1,cosine);e.set_buffer(2,sine);
+    e.set_constant(3,rows);e.set_constant(4,heads);e.set_constant(5,1e-6f);
+    e.dispatch({32,unsigned(rows*heads),2},{32,1,1});
+  }
+  std::string error;
+  if (!stream.commit().wait_ok(&error)) throw std::runtime_error(error);
+  const auto* actual=static_cast<const std::uint16_t*>(candidate.contents());
+  for (int part=0; part<3; ++part) {
+    const auto* reference=static_cast<const std::uint16_t*>(expected[part].contents());
+    for (int t=0; t<rows; ++t) for (int h=0; h<heads; ++h) for (int d=0; d<64; ++d) {
+      const auto value=actual[t*heads*192+h*192+part*64+d];
+      if (value!=reference[(h*rows+t)*64+d] || (value&0x7f80u)==0x7f80u) return false;
+    }
+  }
+  const auto* guard=static_cast<const unsigned char*>(storage.contents());
+  for (int i=0; i<64; ++i)
+    if (guard[i]!=0x55 || guard[storage.byte_size()-64+i]!=0x55) return false;
+  return true;
+}
+}
+
+TEST(minimax_h3_vvae_fused, qk_zero_and_rope_tail) { EXPECT_TRUE(check_qk(1,1)); }
+TEST(minimax_h3_vvae_fused, qk_multiple_rows_and_heads) { EXPECT_TRUE(check_qk(65,3)); }
diff --git a/tests/unit-tests/minimax-h3-vvae-int8.cc b/tests/unit-tests/minimax-h3-vvae-int8.cc
new file mode 100644
index 0000000..985c382
--- /dev/null
+++ b/tests/unit-tests/minimax-h3-vvae-int8.cc
@@ -0,0 +1,73 @@
+#include "minitest.h"
+#include "common/session.h"
+#include "apple-silicon/metal-compute/metal-compute.h"
+#include <algorithm>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+using namespace vpipe::metal_compute;
+namespace {
+uint16_t bf(float f) {auto u=std::bit_cast<uint32_t>(f);return (u+0x7fff+((u>>16)&1))>>16;}
+float fp(uint16_t b) {return std::bit_cast<float>(uint32_t(b)<<16);}
+
+bool check(int M,int N,int K,int tile,bool bias,bool invalid=false) {
+  vpipe::Session session;auto* gpu=session.metal_compute();
+  if (!gpu || !gpu->supports_matrix_cores()) return true;
+  auto lib=gpu->load_library("h3_vae_int8");
+  auto q=lib.function("h3_vae_quant_h256_k"+std::to_string(K));
+  auto mm=lib.function("h3_vae_i8_n"+std::to_string(tile));
+  if (!q.valid()||!mm.valid()) return false;
+  auto alloc=[&](size_t n){auto b=gpu->make_shared_buffer(n);if(b.empty())throw std::runtime_error("test allocation");std::memset(b.contents(),0,n);return b;};
+  auto x=alloc(size_t(M)*K*2),w=alloc(size_t(N)*K*2),b=alloc(N*2);
+  auto xq=alloc(size_t(M)*K),wq=alloc(size_t(N)*K),sx=alloc(M*4),sw=alloc(N*4);
+  auto storage=alloc(size_t(M)*N*2+128),out=storage.subview(64,size_t(M)*N*2);
+  std::memset(storage.contents(),0x55,storage.byte_size());
+  for(auto* buf:{&x,&w,&b})for(size_t i=0;i<buf->byte_size()/2;++i)
+    static_cast<uint16_t*>(buf->contents())[i]=bf(float(int((i*37+11)%193)-96)/128.f);
+  std::memset(x.contents(),0,K*2);
+  static_cast<uint16_t*>(x.contents())[K+37]=bf(128.f);
+  if(invalid){static_cast<uint16_t*>(x.contents())[K+41]=0x7fc0;static_cast<uint16_t*>(w.contents())[2*K+3]=0x7f80;}
+  auto stream=gpu->make_command_stream();
+  {auto enc=stream.begin_compute();
+   auto quant=[&](const SharedBuffer& a,const SharedBuffer& codes,const SharedBuffer& scales,int rows){enc.set_function(q);enc.set_buffer(0,a);enc.set_buffer(1,codes);enc.set_buffer(2,scales);enc.dispatch({unsigned(rows*256),1,1},{256,1,1});};
+   quant(x,xq,sx,M);quant(w,wq,sw,N);
+   enc.set_function(mm);enc.set_buffer(0,xq);enc.set_buffer(1,wq);enc.set_buffer(2,sx);enc.set_buffer(3,sw);enc.set_buffer(4,b);enc.set_buffer(5,out);
+   enc.set_constant(6,K);enc.set_constant(7,N);enc.set_constant(8,M);enc.set_constant(9,int(bias));
+   enc.dispatch({unsigned((N+tile-1)/tile*256),unsigned((M+127)/128),1},{256,1,1});
+  }
+  std::string err;if(!stream.commit().wait_ok(&err))throw std::runtime_error(err);
+  // Dense H256 reference uses its closed-form Kronecker entries, independent
+  // of the GPU's SIMD/register butterfly and reduction implementation.
+  int8_t H[256][256];
+  for(int r=0;r<256;++r)for(int c=0;c<256;++c){int sign=1;for(int d=0;d<4;++d)if(((r>>(2*d))&3)+((c>>(2*d))&3)==3)sign=-sign;H[r][c]=int8_t(sign);}
+  const auto* xp=static_cast<uint16_t*>(x.contents());
+  for(int m=0;m<M;++m){
+    if(invalid&&m==1){if(std::isfinite(static_cast<float*>(sx.contents())[m]))return false;continue;}
+    std::vector<float> v(K);float maximum=0;
+    for(int k=0;k<K;++k){float sum=0;for(int j=0;j<256;++j)sum+=H[k%256][j]*fp(xp[m*K+(k/256)*256+j]);v[k]=sum/16.f;maximum=std::max(maximum,std::abs(v[k]));}
+    const float scale=std::max(maximum/127.f,1.e-30f);
+    if(scale!=static_cast<float*>(sx.contents())[m])return false;
+    for(int k=0;k<K;++k)if(int(std::nearbyint(v[k]/scale))!=static_cast<int8_t*>(xq.contents())[m*K+k])return false;
+  }
+  // Exact INT32 dot product, with the declared BF16 projection/bias rounds.
+  const auto* y=static_cast<uint16_t*>(out.contents());
+  for(int m=0;m<M;++m)for(int n=0;n<N;++n){
+    if(invalid&&(m==1||n==2)){if(std::isfinite(fp(y[m*N+n])))return false;continue;}
+    int32_t dot=0;for(int k=0;k<K;++k)dot+=int32_t(static_cast<int8_t*>(xq.contents())[m*K+k])*int32_t(static_cast<int8_t*>(wq.contents())[n*K+k]);
+    auto ref=bf(float(dot)*static_cast<float*>(sx.contents())[m]*static_cast<float*>(sw.contents())[n]);
+    if(bias)ref=bf(fp(ref)+fp(static_cast<uint16_t*>(b.contents())[n]));
+    if(ref!=y[m*N+n])return false;
+  }
+  const auto* bytes=static_cast<unsigned char*>(storage.contents());
+  for(size_t i=0;i<64;++i)if(bytes[i]!=0x55||bytes[storage.byte_size()-64+i]!=0x55)return false;
+  return true;
+}
+}
+TEST(minimax_h3_vvae_int8, tails_with_bias) { EXPECT_TRUE(check(131,269,256,128,true)); }
+TEST(minimax_h3_vvae_int8, tails_without_bias) { EXPECT_TRUE(check(131,269,256,256,false)); }
+TEST(minimax_h3_vvae_int8, actual_shallow_k) { EXPECT_TRUE(check(3,17,2048,128,true)); }
+TEST(minimax_h3_vvae_int8, actual_deep_k) { EXPECT_TRUE(check(3,17,8192,256,false)); }
+TEST(minimax_h3_vvae_int8, nonfinite_propagates) { EXPECT_TRUE(check(3,17,2048,128,true,true)); }
