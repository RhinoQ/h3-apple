+#ifndef H3_BF16_PREMERGE_H
+#define H3_BF16_PREMERGE_H
+
+#define ACCELERATE_NEW_LAPACK
+#include <Accelerate/Accelerate.h>
+#include <algorithm>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+namespace vpipe::genai::minimax_h3 {
+
+inline float premerge_f32(std::uint16_t value)
+{
+  return std::bit_cast<float>(std::uint32_t(value) << 16);
+}
+
+inline std::uint16_t premerge_bf16(float value)
+{
+  if (!std::isfinite(value)) {
+    throw std::invalid_argument("H3 premerge: nonfinite weight");
+  }
+  std::uint32_t bits = std::bit_cast<std::uint32_t>(value);
+  bits += 0x7fff + ((bits >> 16) & 1);
+  return std::uint16_t(bits >> 16);
+}
+
+// Bound A already includes alpha/rank. For the pinned Turbo adapter this
+// is exactly 8/128, so scaling the BF16 factor loses no nonzero bits.
+// Compute B@A in FP32, add the base separately, then store BF16 once.
+// The destination must be a fresh buffer; input checkpoint bytes stay read-only.
+inline void premerge_bf16_weight(const std::uint16_t* base,
+                                 const std::uint16_t* a,
+                                 const std::uint16_t* b,
+                                 std::uint16_t* output,
+                                 int n, int k, int rank)
+{
+  if (!base || !a || !b || !output || output == base ||
+      output == a || output == b || n <= 0 || k <= 0 || rank <= 0) {
+    throw std::invalid_argument("H3 premerge: invalid buffers or shape");
+  }
+  std::vector<float> a32(std::size_t(rank) * k);
+  std::transform(a, a + a32.size(), a32.begin(), premerge_f32);
+  constexpr int band = 256;
+  std::vector<float> b32(std::size_t(band) * rank);
+  std::vector<float> delta(std::size_t(band) * k);
+  for (int row = 0; row < n; row += band) {
+    const int count = std::min(band, n - row);
+    const auto* source = b + std::size_t(row) * rank;
+    std::transform(source, source + std::size_t(count) * rank,
+                   b32.begin(), premerge_f32);
+    cblas_sgemm(CblasRowMajor, CblasNoTrans, CblasNoTrans,
+                count, k, rank, 1.f, b32.data(), rank, a32.data(), k,
+                0.f, delta.data(), k);
+    const auto offset = std::size_t(row) * k;
+    for (std::size_t i = 0; i < std::size_t(count) * k; ++i) {
+      output[offset + i] = premerge_bf16(
+          premerge_f32(base[offset + i]) + delta[i]);
+    }
+  }
+}
+
+}  // namespace vpipe::genai::minimax_h3
+#endif
