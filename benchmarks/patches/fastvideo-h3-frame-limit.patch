+# SPDX-License-Identifier: Apache-2.0
+"""H3 duration limits must allow the model's required temporal alignment."""
+from __future__ import annotations
+
+import pytest
+
+pytest.importorskip("mlx.core")
+
+from fastvideo.mlx_runtime.minimax_h3_pipeline import MiniMaxH3MLXPipeline
+
+
+@pytest.mark.parametrize("requested_frames", [346, 359, 360, 361, 362])
+def test_fifteen_second_boundary_and_aligned_reentry(requested_frames):
+    geometry = MiniMaxH3MLXPipeline.resolve_geometry(768, 1376, requested_frames)
+    assert geometry == {
+        "height": 768,
+        "width": 1376,
+        "num_frames": 362,
+        "latent_frame_count": 107,
+        "latent_height": 48,
+        "latent_width": 86,
+    }
+    # generate() and denoise() validate already-aligned geometry again.
+    assert MiniMaxH3MLXPipeline.resolve_geometry(768, 1376, geometry["num_frames"]) == geometry
+
+
+@pytest.mark.parametrize("frames", range(124, 363, 17))
+def test_supported_model_frame_lattice(frames):
+    assert MiniMaxH3MLXPipeline.resolve_geometry(576, 1024, frames)["num_frames"] == frames
+
+
+@pytest.mark.parametrize("requested, aligned", [(120, 124), (240, 243), (344, 345)])
+def test_existing_valid_requests_keep_their_geometry(requested, aligned):
+    assert MiniMaxH3MLXPipeline.resolve_geometry(768, 1376, requested)["num_frames"] == aligned
+
+
+@pytest.mark.parametrize("frames", [1, 107, 363, 379, 480])
+def test_outside_supported_duration_still_rejected(frames):
+    with pytest.raises(ValueError, match="H3 generates 5-15 s"):
+        MiniMaxH3MLXPipeline.resolve_geometry(768, 1376, frames)
+
+
+def test_internal_short_temporal_geometry_remains_available():
+    assert MiniMaxH3MLXPipeline.resolve_geometry(768, 1376, 39, enforce_duration=False)["num_frames"] == 39
+
+
+@pytest.mark.parametrize("height, width", [(0, 1376), (768, 0), (768, 1366)])
+def test_invalid_canvas_still_rejected(height, width):
+    with pytest.raises(ValueError, match="positive multiples of 32"):
+        MiniMaxH3MLXPipeline.resolve_geometry(height, width, 362)
