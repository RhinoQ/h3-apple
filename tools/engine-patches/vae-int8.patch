+using namespace metal;
+using namespace mpp::tensor_ops;
+
+// H256 = (H4 / 2)^tensor4, H4 symmetric with a negative anti-diagonal.
+// The rotation preserves dot products before quantization and disperses channel
+// outliers. Algorithm reference: Comfy Kitchen's ConvRot INT8 linear (Apache-2.0),
+// comfy_kitchen/backends/cuda/ops/int8_linear.cu. This is a native Metal kernel.
+static inline float h4(uint d, float a, float b, float c, float e) {
+  const uint neg = 3 - d;
+  a = neg == 0 ? -a : a; b = neg == 1 ? -b : b;
+  c = neg == 2 ? -c : c; e = neg == 3 ? -e : e;
+  return 0.5f * (((a + b) + c) + e);
+}
